{
  "version": "v2",
  "name": "Tv_Tizen.Action.IoT_GetSelfDevices",
  "type": "tidl",
  "category": "Tizen.Action.IoT",
  "description": "Lists IoTSelfDevice entries in the single home this TV is registered to, the TV itself included, each with DeviceCategory. IoT_GetDevices searches every home with DeviceQuery filters",
  "keyword": [
    "iot",
    "get",
    "self",
    "devices"
  ],
  "allowedBackground": "true",
  "autoDispose": "false",
  "requiredPrivileges": [],
  "requiresConfirmation": false,
  "providerPrivilegeLevel": "public",
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "array",
        "description": "A smart-home device in the home this TV is registered to, carrying the Device fields plus DeviceCategory. Identity is tracked via inherited Id",
        "items": {
          "type": "&Tizen.Entity.IoTSelfDevice"
        }
      }
    }
  },
  "details": {
    "appid": "com.samsung.tizen.smartthings-client"
  }
}
