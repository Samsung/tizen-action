{
  "typeName": "Tizen.Entity.File",
  "description": "A file on a storage medium, with Path, StorageType (internal/usb/network), Size and ModifiedDate. Carried by Track.File and Content.File, and played on its own by the PlayFile actions",
  "base": "Tizen.Entity",
  "dataSchema": {
    "type": "object",
    "required": [
      "Path",
      "StorageType"
    ],
    "properties": {
      "Path": {
        "type": "string",
        "description": "Full path of the file on its storage medium, such as /opt/usr/media/Movies/a.mp4"
      },
      "StorageType": {
        "type": "string",
        "description": "Medium the file lives on: internal storage, usb drive or network share",
        "enum": [
          "internal",
          "usb",
          "network"
        ]
      },
      "Size": {
        "type": "integer",
        "description": "Size of the file in bytes, as reported by the storage"
      },
      "ModifiedDate": {
        "type": "string",
        "description": "When the file was last modified, as reported by the storage; not needed to play the file"
      }
    }
  }
}
