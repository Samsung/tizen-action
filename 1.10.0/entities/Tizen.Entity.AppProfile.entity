{
  "typeName": "Tizen.Entity.AppProfile",
  "description": "In-app viewing profile with content rating kind",
  "base": "Tizen.Entity",
  "dataSchema": {
    "type": "object",
    "required": [
      "Name",
      "IsCurrent"
    ],
    "properties": {
      "Name": {
        "type": "string",
        "description": "Display name of the in-app viewing profile; also its identifier when Id is empty"
      },
      "ImageUrl": {
        "type": "string",
        "description": "URL of the profile's avatar image, used only for display"
      },
      "Kind": {
        "type": "string",
        "description": "Content rating kind of the profile, adult or kid; absent for a general profile",
        "enum": [
          "adult",
          "kid"
        ]
      },
      "IsCurrent": {
        "type": "boolean",
        "description": "True when this is the in-app profile currently in use"
      }
    }
  }
}
