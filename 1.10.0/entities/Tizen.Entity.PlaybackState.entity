{
  "typeName": "Tizen.Entity.PlaybackState",
  "description": "Read-only playback snapshot that never names the item - the sibling item, or the pane's Content, says what plays. Format is how it renders now, not its type. Change via PlaybackSetting",
  "base": "Tizen.Entity",
  "dataSchema": {
    "type": "object",
    "required": [
      "Status"
    ],
    "properties": {
      "Status": {
        "type": "string",
        "description": "Current player state: playing, paused or stopped",
        "enum": [
          "playing",
          "paused",
          "stopped"
        ]
      },
      "Position": {
        "type": "integer",
        "description": "Current playback position in seconds from the start of the item"
      },
      "Shuffle": {
        "type": "string",
        "description": "Shuffle mode currently in effect, on or off",
        "enum": [
          "on",
          "off"
        ]
      },
      "Repeat": {
        "type": "string",
        "description": "Repeat mode currently in effect: off, one or all",
        "enum": [
          "off",
          "one",
          "all"
        ]
      },
      "Speed": {
        "type": "string",
        "description": "Playback rate currently in effect, 0.25 to 2.0",
        "enum": [
          "0.25",
          "0.5",
          "0.75",
          "1.0",
          "1.25",
          "1.5",
          "1.75",
          "2.0"
        ]
      },
      "Format": {
        "type": "string",
        "description": "How the item renders now, audio or video; a Track played as its music video says video",
        "enum": [
          "audio",
          "video"
        ]
      }
    }
  }
}
