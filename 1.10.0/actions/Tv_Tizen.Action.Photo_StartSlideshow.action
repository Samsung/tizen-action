{
  "version": "v2",
  "name": "Tv_Tizen.Action.Photo_StartSlideshow",
  "type": "tidl",
  "category": "Tizen.Action.Photo",
  "description": "Start a slideshow over the given photos; when empty it plays the source open now, the one Photo_Open lands on; returns the photos actually playing",
  "allowedBackground": "false",
  "autoDispose": "false",
  "requiredPrivileges": [],
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "object",
    "required": [
      "Photo"
    ],
    "properties": {
      "Photo": {
        "type": "array",
        "description": "A photo or video item from a photo app or the TV camera: Location, Date, File, Note, ThumbnailUrl, MediaType (photo or video), the People, Activities and Objects found in it, and the Source it came from",
        "items": {
          "type": "Tizen.Entity.Photo"
        }
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "array",
        "description": "A photo or video item from a photo app or the TV camera: Location, Date, File, Note, ThumbnailUrl, MediaType (photo or video), the People, Activities and Objects found in it, and the Source it came from",
        "items": {
          "type": "Tizen.Entity.Photo"
        }
      }
    }
  },
  "details": {
    "appid": ""
  }
}
