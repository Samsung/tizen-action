{
  "version": "v2",
  "name": "Tv_Tizen.Action.IoT_GetLocations",
  "type": "tidl",
  "category": "Tizen.Action.IoT",
  "description": "Lists the locations (homes) on the user's account. Feed an IoTLocation to Tv_Tizen.Action.IoT_GetRooms, IoT_GetDevices, or IoT_GetScenes",
  "allowedBackground": "true",
  "autoDispose": "false",
  "requiredPrivileges": [],
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "array",
        "description": "A home registered on the user's IoT account, carrying Name, coordinates (Latitude, Longitude), and Radius. Identity is tracked via inherited Id",
        "items": {
          "type": "Tizen.Entity.IoTLocation"
        }
      }
    }
  },
  "details": {
    "appid": "com.samsung.tizen.smartthings-client"
  }
}
