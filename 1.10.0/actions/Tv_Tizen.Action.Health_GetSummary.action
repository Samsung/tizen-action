{
  "version": "v2",
  "name": "Tv_Tizen.Action.Health_GetSummary",
  "type": "tidl",
  "category": "Tizen.Action.Health",
  "description": "Get today's personal health data summary (activity/sleep/stress/heart rate/streak/preference)",
  "allowedBackground": "true",
  "autoDispose": "false",
  "requiredPrivileges": [
    "http://tizen.org/privilege/healthinfo"
  ],
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "Tizen.Entity.HealthSummary",
        "description": "A daily health summary: Date, Steps, ActiveCalories, ActiveMinutes, ExerciseStreakDays, StrengthTrainingCount, HeartRate, Sleep, Stress, and Preferences"
      }
    }
  },
  "details": {
    "appid": "com.samsung.tv.samsung-health"
  }
}
