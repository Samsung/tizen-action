{
  "version": "v2",
  "name": "Tv_Tizen.Action.Video_GetContentAngles",
  "type": "tidl",
  "category": "Tizen.Action.Video",
  "description": "Returns the ContentAngle items one Content offers - camera angles, member cams - with the Label to match against the request, or an empty list. Switch with Tv_Tizen.Action.Video_ControlPane",
  "allowedBackground": "false",
  "autoDispose": "false",
  "requiredPrivileges": [],
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "object",
    "required": [
      "content"
    ],
    "properties": {
      "content": {
        "base": "Tizen.Entity.Content",
        "description": "One video item - movie, episode, clip, artist_video or sports_event, from a local file, vod or live stream; movie has no subtype, the others map to Episode/Clip/ArtistVideo/SportsEvent"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "array",
        "description": "An alternative camera angle. The list never includes the default feed. person_cam requires Subject. Match a request by Subject.Name, then Label, then AngleType; ask the user if still tied",
        "items": {
          "type": "Tizen.Entity.ContentAngle"
        }
      }
    }
  },
  "details": {
    "appid": ""
  }
}
