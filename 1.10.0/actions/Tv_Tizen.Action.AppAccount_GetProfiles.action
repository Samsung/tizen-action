{
  "version": "v2",
  "name": "Tv_Tizen.Action.AppAccount_GetProfiles",
  "type": "tidl",
  "category": "Tizen.Action.AppAccount",
  "description": "List the app's own viewing AppProfiles; empty when it has none or nobody is signed in. TV user profiles: Tv_Tizen.Action.Profile_GetProfiles",
  "allowedBackground": "true",
  "autoDispose": "false",
  "requiredPrivileges": [],
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "array",
        "description": "In-app viewing profile with content rating kind",
        "items": {
          "type": "Tizen.Entity.AppProfile"
        }
      }
    }
  },
  "details": {
    "appid": "rJeHak5zRg.Spotify"
  }
}
