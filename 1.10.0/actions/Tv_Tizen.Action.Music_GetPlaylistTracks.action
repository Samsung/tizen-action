{
  "version": "v2",
  "name": "Tv_Tizen.Action.Music_GetPlaylistTracks",
  "type": "tidl",
  "category": "Tizen.Action.Music",
  "description": "Returns the Playable items inside one Playlist in order - Track, PodcastEpisode or ArtistVideo. Find it via Tv_Tizen.Action.Music_SearchPlaylist; now-playing order: Tv_Tizen.Action.Music_GetQueue",
  "allowedBackground": "true",
  "autoDispose": "false",
  "requiredPrivileges": [],
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "object",
    "required": [
      "playlist"
    ],
    "properties": {
      "playlist": {
        "type": "Tizen.Entity.Playlist",
        "description": "A user-created or curated set of items with Title (from Playable), Owner, TrackCount and CoverUrl. Items: Tv_Tizen.Action.Music_GetPlaylistTracks; distinct from Queue, the now-playing order"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "array",
        "description": "Base of every playable item: Title, Formats (audio/video; empty=unknown, video implies audio). A base(Playable) slot may omit TypeName - treat as untyped. Never Station or Artist",
        "items": {
          "base": "Tizen.Entity.Playable",
          "description": "Base of every playable item: Title, Formats (audio/video; empty=unknown, video implies audio). A base(Playable) slot may omit TypeName - treat as untyped. Never Station or Artist"
        }
      }
    }
  },
  "details": {
    "appid": ""
  }
}
