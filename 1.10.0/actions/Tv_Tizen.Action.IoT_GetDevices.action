{
  "version": "v2",
  "name": "Tv_Tizen.Action.IoT_GetDevices",
  "type": "tidl",
  "category": "Tizen.Action.IoT",
  "description": "Lists lightweight smart-home devices matching DeviceQuery (Location, Room, Health, DeviceCategory, plus inherited Keyword free-text search). Each returned Device carries only core metadata with no nested commands or capability statuses",
  "allowedBackground": "true",
  "autoDispose": "false",
  "requiredPrivileges": [],
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "Tizen.Entity.DeviceQuery"
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "array",
        "description": "A lightweight smart-home device carrying Name, Location, Room, and Health state. Identity is tracked via inherited Id",
        "items": {
          "type": "Tizen.Entity.Device"
        }
      }
    }
  },
  "details": {
    "appid": "com.samsung.tizen.smartthings-client"
  }
}
