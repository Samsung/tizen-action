{
  "version": "v2",
  "name": "Tv_Tizen.Action.Browser_GetTabs",
  "type": "tidl",
  "category": "Tizen.Action.Browser",
  "description": "List every open tab",
  "allowedBackground": "false",
  "autoDispose": "false",
  "requiredPrivileges": [],
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "array",
        "description": "An open browser tab: the Page it shows, its Ordinal in the tab strip, Focused for the tab in front, and Secret. Url and Title are read from the composed WebPageInfo",
        "items": {
          "type": "Tizen.Entity.Tab"
        }
      }
    }
  },
  "details": {
    "appid": "org.tizen.next-browser"
  }
}
