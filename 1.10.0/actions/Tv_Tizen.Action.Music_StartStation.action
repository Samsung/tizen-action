  ],
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "Tizen.Entity.Station"
  },
  "outputSchema": {
    "type": "Tizen.Entity.Status"
  },
  "details": {
    "appid": ""
  }
}
