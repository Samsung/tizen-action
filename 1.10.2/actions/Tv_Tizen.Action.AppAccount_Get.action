{
  "version": "v2",
  "name": "Tv_Tizen.Action.AppAccount_Get",
  "type": "tidl",
  "category": "Tizen.Action.AppAccount",
  "description": "Get the app's own sign-in state, Subscription and current AppProfile. The TV's user profile: Tv_Tizen.Action.Profile_GetCurrentProfile",
  "allowedBackground": "true",
  "allowedFanout": true,
  "autoDispose": "false",
  "requiredPrivileges": [],
  "requiresConfirmation": false,
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "Tizen.Entity.AppAccount",
        "description": "App's own sign-in state, subscription, and active viewing profile"
      }
    }
  },
  "details": {
    "appid": ""
  }
}
