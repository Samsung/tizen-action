{
  "version": "v2",
  "name": "Tv_Tizen.Action.Video_ControlPane",
  "type": "tidl",
  "category": "Tizen.Action.Video",
  "description": "Applies one PaneCommand to a single pane of in-app multiview - focus, sound focus, make primary, set angle or close. Pause and seek go to Tv_Tizen.Action.Video_Control",
  "allowedBackground": "false",
  "requiresRunning": true,
  "autoDispose": "false",
  "requiredPrivileges": [
    "http://tizen.org/privilege/mediacontroller.client"
  ],
  "requiresConfirmation": false,
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "Tizen.Entity.PaneCommand"
  },
  "outputSchema": {
    "type": "Tizen.Entity.Status"
  },
  "details": {
    "appid": ""
  }
}
