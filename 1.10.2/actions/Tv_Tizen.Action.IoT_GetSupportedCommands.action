{
  "version": "v2",
  "name": "Tv_Tizen.Action.IoT_GetSupportedCommands",
  "type": "tidl",
  "category": "Tizen.Action.IoT",
  "description": "Fetches the supported commands with rich schema guides for a specific lightweight device",
  "allowedBackground": "true",
  "autoDispose": "false",
  "requiredPrivileges": [],
  "requiresConfirmation": false,
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "Tizen.Entity.Device"
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "array",
        "description": "An executable command the device supports: Component, Capability, CommandName, and an ArgumentsSchema for AI command synthesis",
        "items": {
          "type": "Tizen.Entity.SupportedDeviceCommand"
        }
      }
    }
  },
  "details": {
    "appid": "com.samsung.tv.vd-sc-client-service"
  }
}
