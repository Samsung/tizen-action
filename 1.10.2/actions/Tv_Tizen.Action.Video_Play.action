{
  "version": "v2",
  "name": "Tv_Tizen.Action.Video_Play",
  "type": "tidl",
  "category": "Tizen.Action.Video",
  "description": "Plays one Content or Series passed as a Playable; a Series resumes at its next unwatched Episode. Change what is already playing with Tv_Tizen.Action.Video_Control",
  "allowedBackground": "false",
  "autoDispose": "false",
  "requiredPrivileges": [
    "http://tizen.org/privilege/mediacontroller.client"
  ],
  "requiresConfirmation": false,
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "object",
    "required": [
      "item"
    ],
    "properties": {
      "item": {
        "base": "Tizen.Entity.Playable",
        "description": "Base of every playable item: Title, Formats (audio/video; empty=unknown, video implies audio). A base(Playable) slot may omit TypeName - treat as untyped. Never Station or Artist"
      }
    }
  },
  "outputSchema": {
    "type": "Tizen.Entity.Status"
  },
  "details": {
    "appid": ""
  }
}
