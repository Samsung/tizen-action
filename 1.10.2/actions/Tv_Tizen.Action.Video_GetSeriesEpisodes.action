{
  "version": "v2",
  "name": "Tv_Tizen.Action.Video_GetSeriesEpisodes",
  "type": "tidl",
  "category": "Tizen.Action.Video",
  "description": "Returns the Episode items of one Series in order, each with its SeasonNumber and EpisodeNumber. Takes a Series, so find the show with Tv_Tizen.Action.Video_SearchSeries first",
  "allowedBackground": "true",
  "autoDispose": "false",
  "requiredPrivileges": [],
  "requiresConfirmation": false,
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "Tizen.Entity.Series"
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "array",
        "description": "One installment of a show: parent Series, SeasonNumber, EpisodeNumber. Returned when a request names a specific episode. Get a show's full list via Tv_Tizen.Action.Video_GetSeriesEpisodes",
        "items": {
          "type": "Tizen.Entity.Episode"
        }
      }
    }
  },
  "details": {
    "appid": ""
  }
}
