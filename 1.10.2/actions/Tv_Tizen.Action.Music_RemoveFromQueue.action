{
  "version": "v2",
  "name": "Tv_Tizen.Action.Music_RemoveFromQueue",
  "type": "tidl",
  "category": "Tizen.Action.Music",
  "description": "Removes one Playable - Track, PodcastEpisode or ArtistVideo - from the Queue; rejects Album, Playlist, PodcastShow. Fails with Reason if no playback session is alive. Saved playlist is untouched",
  "allowedBackground": "true",
  "requiresRunning": true,
  "autoDispose": "false",
  "requiredPrivileges": [
    "http://tizen.org/privilege/mediacontroller.client"
  ],
  "requiresConfirmation": false,
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "object",
    "required": [
      "item"
    ],
    "properties": {
      "item": {
        "base": "Tizen.Entity.Playable",
        "description": "Base of every playable item: Title, Formats (audio/video; empty=unknown, video implies audio). A base(Playable) slot may omit TypeName - treat as untyped. Never Station or Artist"
      }
    }
  },
  "outputSchema": {
    "type": "Tizen.Entity.Status"
  },
  "details": {
    "appid": ""
  }
}
