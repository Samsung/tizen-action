{
  "version": "v2",
  "name": "Tv_Tizen.Action.Music_SearchPlaylist",
  "type": "tidl",
  "category": "Tizen.Action.Music",
  "description": "Searches saved and curated playlists with MusicQuery and returns Playlist items. Returns user playlists, never the now-playing queue - use Tv_Tizen.Action.Music_GetQueue for what is playing next",
  "allowedBackground": "true",
  "allowedFanout": true,
  "autoDispose": "false",
  "requiredPrivileges": [],
  "requiresConfirmation": false,
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "Tizen.Entity.MusicQuery"
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "array",
        "description": "A user-created or curated set of items with Title (from Playable), Owner, TrackCount and CoverUrl. Items: Tv_Tizen.Action.Music_GetPlaylistTracks; distinct from Queue, the now-playing order",
        "items": {
          "type": "Tizen.Entity.Playlist"
        }
      }
    }
  },
  "details": {
    "appid": ""
  }
}
