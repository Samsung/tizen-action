{
  "version": "v2",
  "name": "Tv_Tizen.Action.AppAccount_GetSubscriptionPlans",
  "type": "tidl",
  "category": "Tizen.Action.AppAccount",
  "description": "List the subscription plans the app sells, with list price, free trial and signup Promotion; empty when it sells none. Current plan: Tv_Tizen.Action.AppAccount_Get",
  "allowedBackground": "true",
  "allowedFanout": true,
  "autoDispose": "false",
  "requiredPrivileges": [],
  "requiresConfirmation": false,
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "array",
        "description": "A subscription plan the app sells; Id is the value Subscription.PlanId names. Promotion is the signup discount, paid for its Duration before the list Price",
        "items": {
          "type": "Tizen.Entity.SubscriptionPlan"
        }
      }
    }
  },
  "details": {
    "appid": ""
  }
}
