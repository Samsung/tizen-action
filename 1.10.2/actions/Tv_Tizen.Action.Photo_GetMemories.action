{
  "version": "v2",
  "name": "Tv_Tizen.Action.Photo_GetMemories",
  "type": "tidl",
  "category": "Tizen.Action.Photo",
  "description": "Get the app's curated memory feed such as trip highlights; play one with Tv_Tizen.Action.Photo_PlayMemory",
  "allowedBackground": "true",
  "autoDispose": "false",
  "requiredPrivileges": [],
  "requiresConfirmation": false,
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "Tizen.Entity.MemoryFeed",
        "description": "The feed Photo_GetMemories returns: Memories in the app's order, RecommendationIndex naming the one to feature (-1 when none), Locked when a content lock hides it, NextRefreshTime for the next set"
      }
    }
  },
  "details": {
    "appid": "com.samsung.tv.google-photos-service"
  }
}
