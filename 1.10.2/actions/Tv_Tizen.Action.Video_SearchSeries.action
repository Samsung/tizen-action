{
  "version": "v2",
  "name": "Tv_Tizen.Action.Video_SearchSeries",
  "type": "tidl",
  "category": "Tizen.Action.Video",
  "description": "Searches shows with ContentQuery and returns Series items with their season and episode counts. For individual movies, episodes and clips use Tv_Tizen.Action.Video_SearchContent",
  "allowedBackground": "true",
  "allowedFanout": true,
  "autoDispose": "false",
  "requiredPrivileges": [],
  "requiresConfirmation": false,
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "Tizen.Entity.ContentQuery"
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "array",
        "description": "A whole show; counts only - episodes via Tv_Tizen.Action.Video_GetSeriesEpisodes. Director is the show's lead director, not an Episode's own Content.Director. Play via Tv_Tizen.Action.Video_Play",
        "items": {
          "type": "Tizen.Entity.Series"
        }
      }
    }
  },
  "details": {
    "appid": ""
  }
}
