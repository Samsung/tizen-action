{
  "version": "v2",
  "name": "Tv_Tizen.Action.ScreenShare_Stop",
  "type": "tidl",
  "category": "Tizen.Action.ScreenShare",
  "description": "Ends the active mirroring or casting session, disconnecting the sender and returning the TV to its previous source. Takes no input. The only way to end a session - PlaybackCommand stop is rejected. A not-running error means no session is active - do not launch the app to retry",
  "allowedBackground": "false",
  "requiresRunning": true,
  "autoDispose": "false",
  "requiredPrivileges": [],
  "requiresConfirmation": false,
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "Tizen.Entity.Status"
  },
  "details": {
    "appid": "com.samsung.tv.googlecast-service"
  }
}
