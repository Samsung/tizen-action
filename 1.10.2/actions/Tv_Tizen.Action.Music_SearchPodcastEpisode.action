{
  "version": "v2",
  "name": "Tv_Tizen.Action.Music_SearchPodcastEpisode",
  "type": "tidl",
  "category": "Tizen.Action.Music",
  "description": "Searches podcast episodes across shows with PodcastQuery and returns PodcastEpisode items with PlayState and ResumePosition. For whole shows use Tv_Tizen.Action.Music_SearchPodcast",
  "allowedBackground": "true",
  "allowedFanout": true,
  "autoDispose": "false",
  "requiredPrivileges": [],
  "requiresConfirmation": false,
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "Tizen.Entity.PodcastQuery"
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "array",
        "description": "A podcast episode. ResumePosition (seconds) is valid only while PlayState is in_progress, else 0. No File field - episodes always stream. Play via Tv_Tizen.Action.Music_Play",
        "items": {
          "type": "Tizen.Entity.PodcastEpisode"
        }
      }
    }
  },
  "details": {
    "appid": ""
  }
}
