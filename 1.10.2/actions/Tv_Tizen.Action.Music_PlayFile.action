{
  "version": "v2",
  "name": "Tv_Tizen.Action.Music_PlayFile",
  "type": "tidl",
  "category": "Tizen.Action.Music",
  "description": "Plays the single file at File.Path, with StorageType picking the medium. Takes no search result, unlike Tv_Tizen.Action.Music_Play, which plays a Playable the app already knows",
  "allowedBackground": "false",
  "autoDispose": "false",
  "requiredPrivileges": [
    "http://tizen.org/privilege/mediastorage",
    "http://tizen.org/privilege/externalstorage"
  ],
  "requiresConfirmation": false,
  "providerPrivilegeLevel": "partner",
  "inputSchema": {
    "type": "object",
    "required": [
      "source"
    ],
    "properties": {
      "source": {
        "type": "Tizen.Entity.File",
        "description": "A file on a storage medium, with Path, StorageType (internal/usb/network), Size and ModifiedDate. Carried by Track.File and Content.File, and played on its own by the PlayFile actions"
      }
    }
  },
  "outputSchema": {
    "type": "Tizen.Entity.Status"
  },
  "details": {
    "appid": "com.samsung.tv.mycontents"
  }
}
