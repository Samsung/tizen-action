{
  "typeName": "Tizen.Entity.SleepData",
  "description": "Last night's sleep bounded by StartTime and EndTime, with DurationMinutes and Score when the app has them",
  "dataSchema": {
    "type": "object",
    "required": [
      "StartTime",
      "EndTime"
    ],
    "properties": {
      "StartTime": {
        "type": "string",
        "description": "When the sleep began, local time as yyyy-MM-dd HH:mm:ss without offset, such as 2026-10-26 23:10:00"
      },
      "EndTime": {
        "type": "string",
        "description": "When the sleep ended, local time as yyyy-MM-dd HH:mm:ss without offset, such as 2026-10-27 07:05:00"
      },
      "DurationMinutes": {
        "type": "integer",
        "description": "Minutes slept between StartTime and EndTime, computed by the app from the pair; absent when not computed"
      },
      "Score": {
        "type": "integer",
        "description": "Sleep quality score as an integer; absent when the app has no score, which the current app never provides"
      }
    }
  }
}
