{
  "version": "v2",
  "name": "Tv_Tizen.Action.IoT_GetSelfLocation",
  "type": "tidl",
  "category": "Tizen.Action.IoT",
  "description": "Returns the single SmartThings home this TV is registered to, as IoTSelfLocation with its rooms. IoT_GetLocations lists every home on the account instead",
  "keyword": [
    "iot",
    "get",
    "self",
    "location"
  ],
  "allowedBackground": "true",
  "autoDispose": "false",
  "requiredPrivileges": [],
  "requiresConfirmation": false,
  "providerPrivilegeLevel": "public",
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "return",
      "result"
    ],
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Result wrapper returned by every action, carrying Success (whether the action was carried out, not whether it found anything) and Reason (empty on ordinary success; otherwise a prefix plus text - noop/clamped/partial/defaulted when Success is true, rejected/invalid/unsupported/unavailable when it is false)"
      },
      "result": {
        "type": "Tizen.Entity.IoTSelfLocation",
        "description": "The SmartThings home this TV is registered to, carrying the IoTLocation fields plus its rooms. Identity is tracked via inherited Id"
      }
    }
  },
  "details": {
    "appid": "com.samsung.tizen.smartthings-client"
  }
}
